{
 "id": "alg.sqrt",
 "easy": "제곱해서 그 수가 되는 값. 벡터 크기 √(x² + y²) 와 (z² + R²)^(3/2) 같은 식을 두려워하지 않기 위해 필요.",
 "core": "√a 는 제곱하면 a 가 되는 양수 (a ≥ 0). √(a²) = |a|\n√(ab) = √a·√b,  √(a/b) = √a/√b  (합은 못 쪼갬: √(a+b) ≠ √a + √b)\na^(1/2) = √a,  a^(3/2) = a·√a,  (a²)^(3/2) = a³\n유리화: 1/√2 = √2/2\n대표값: √2 ≈ 1.414, √3 ≈ 1.732",
 "example": {
  "q": "(z² + R²)^(3/2) 를 z = 4, R = 3 에서 계산하라",
  "steps": [
   "z² + R² = 16 + 9 = 25",
   "25^(3/2) = (√25)³ = 5³ = 125"
  ]
 },
 "pitfall": "√(a² + b²) 를 a + b 로 쓰는 것. √(9 + 16) = 5 이지 7 이 아니다.",
 "quiz": [
  {
   "q": "√(9 + 16) 은?",
   "options": [
    "7",
    "5",
    "25",
    "12.5"
   ],
   "answer": 1,
   "why": "√25 = 5."
  },
  {
   "q": "25^(3/2) 는?",
   "options": [
    "37.5",
    "125",
    "75",
    "12.5"
   ],
   "answer": 1,
   "why": "(√25)³ = 5³."
  },
  {
   "q": "√(a+b) 는?",
   "options": [
    "√a + √b",
    "쪼갤 수 없다",
    "√a·√b",
    "a + b"
   ],
   "answer": 1,
   "why": "합의 제곱근은 분리되지 않는다."
  },
  {
   "q": "1/√2 를 유리화하면?",
   "options": [
    "√2",
    "√2/2",
    "2/√2",
    "1/2"
   ],
   "answer": 1,
   "why": "분모·분자에 √2."
  },
  {
   "q": "√(x²) 는?",
   "options": [
    "x",
    "|x|",
    "−x",
    "x²"
   ],
   "answer": 1,
   "why": "음수 x 도 양수로."
  }
 ],
 "src": "일반 지식(표준 정의)"
}
