  {
   "q": "∫sin x dx 는?",
   "options": [
    "cos x + C",
    "−cos x + C",
    "sin x + C",
    "−sin x + C"
   ],
   "answer": 1,
   "why": "(−cos x)′ = sin x."
  }
 ],
