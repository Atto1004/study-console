  "title": "13.1 벡터함수 — 정의역·극한·공간곡선·선분",
  "goals": [
    "벡터함수와 성분",
    "정의역은 교집합",
    "극한은 성분별로",
    "공간곡선과 직선",
    "나선의 투영과 교점",
    "두 점을 잇는 선분"
  ],
  "recap": [],
  "sections": [
    {
      "title": "벡터함수와 성분",
      "script": {
        "s1-1:0": [
          {
            "say": "\\(\\mathbf r(t)=(f(t),g(t),h(t))\\)는 t 하나를 넣으면 위치벡터 하나가 나오는 함수입니다.",
            "mood": "neutral"
          },
          {
            "say": "세 성분이 각각 x,y,z 좌표를 정합니다.",
            "mood": "neutral"
          }
        ],
        "s1-2:0": [
          {
            "say": "\\(\\mathbf r(t)=(1+t,2+5t,-1+6t)\\)에서 t=0이면 (1,2,−1), t=1이면 (2,7,5)입니다.",
            "mood": "neutral"
          }
        ]
      },
      "check": "q1"
    },
    {
      "title": "정의역은 교집합",
      "script": {
        "s2-1:0": [
          {
            "say": "정의역은 모든 성분을 동시에 계산할 수 있는 t입니다.",
            "mood": "neutral"
          },
          {
            "say": "로그의 진수는 양수, 실수 제곱근의 안은 0 이상이어야 합니다.",
            "mood": "neutral"
          }
        ],
        "s2-2:0": [
          {
            "say": "\\(\\mathbf r(t)=(t^3,\\ln(3-t),\\sqrt t)\\): 로그는 t<3, 제곱근은 t≥0.",
            "mood": "neutral"
          },
          {
            "say": "교집합은 \\([0,3)\\)입니다.",
            "mood": "neutral"
          }
        ]
      },
      "check": "q2"
    },
    {
      "title": "극한은 성분별로",
      "script": {
        "s3-1:0": [
          {
            "say": "벡터함수의 극한은 각 성분의 극한을 구한 뒤 한 벡터로 모읍니다.",
            "mood": "neutral"
          },
          {
            "say": "모든 성분 극한이 존재해야 합니다.",
            "mood": "neutral"
          }
        ],
        "s3-2:0": [
          {
            "say": "\\(\\lim_{t\\to0}(1+t^3,te^{-t},\\sin t/t)=(1,0,1)\\).",
            "mood": "neutral"
          },
          {
            "say": "마지막 성분은 t=0에 직접 대입하는 대신 표준극한을 씁니다.",
            "mood": "neutral"
          }
        ]
      },
      "check": "q3"
    },
    {
      "title": "공간곡선과 직선",
      "script": {
        "s4-1:0": [
          {
            "say": "\\(\\mathbf r(t)=\\mathbf r_0+t\\mathbf v\\)에서 \\(\\mathbf v\\neq\\mathbf0\\)이면 직선입니다.",
            "mood": "neutral"
          },
          {
            "say": "t가 모든 실수이면 양방향 전체 직선이 됩니다.",
            "mood": "neutral"
          }
        ],
        "s4-2:0": [
          {
            "say": "(1+t,2+5t,−1+6t)의 시작점은 (1,2,−1), 방향벡터는 (1,5,6)입니다.",
            "mood": "neutral"
          },
          {
            "say": "좌표의 상수항과 t의 계수를 분리해 읽습니다.",
            "mood": "neutral"
          }
        ]
      },
      "check": "q4"
    },
    {
      "title": "나선의 투영과 교점",
      "script": {
        "s5-1:0": [
          {
            "say": "\\(\\mathbf r(t)=(\\cos t,\\sin t,t)\\)는 \\(x^2+y^2=1\\)인 원기둥 위 나선입니다.",
            "mood": "neutral"
          },
          {
            "say": "xy평면으로 투영한 자취는 원이지만, z=0과 만나는 곳은 t=0 한 점입니다.",
            "mood": "neutral"
          }
        ],
        "s5-2:0": [
          {
            "say": "t=0이면 (1,0,0), t=π/2이면 (0,1,π/2).",
            "mood": "neutral"
          },
          {
            "say": "높이가 계속 변하므로 공간곡선 전체가 xy평면의 원은 아닙니다.",
            "mood": "neutral"
          }
        ]
      },
      "check": "q5"
    },
    {
      "title": "두 점을 잇는 선분",
      "script": {
        "s6-1:0": [
          {
            "say": "P에서 Q로 가는 선분은 \\(\\mathbf r(t)=(1-t)P+tQ=P+t(Q-P),\\ 0\\leq t\\leq1\\)입니다.",
            "mood": "neutral"
          },
          {
            "say": "t 범위까지 써야 선분이 됩니다.",
            "mood": "neutral"
          }
        ],
        "s6-2:0": [
          {
            "say": "P(1,3,−2), Q(2,−1,3): Q−P=(1,−4,5).",
            "mood": "neutral"
          },
          {
            "say": "따라서 (1+t,3−4t,−2+5t), 0≤t≤1.",
            "mood": "neutral"
          },
          {
            "say": "t=0과 1을 넣어 끝점을 검산합니다.",
            "mood": "neutral"
          }
        ]
      },
      "check": "q6"
    }
  ],
