  "title": "3.1~3.3 고계 선형방정식 — 중근·오일러코시·공명",
  "goals": [
    "기저와 론스키안",
    "서로 다른 실근",
    "중근과 복소 이중근",
    "0 중근과 다른 중근 함께",
    "고계 오일러코시",
    "비제차 공명과 초기조건"
  ],
  "recap": [],
  "sections": [
    {
      "title": "기저와 론스키안",
      "script": {
        "s1-1:0": [
          {
            "say": "n계 제차 선형방정식의 일반해는 독립인 해 n개의 선형결합입니다.",
            "mood": "neutral"
          },
          {
            "say": "계수가 연속인 같은 표준형 제차방정식의 해들에 대해 W가 한 점에서 0이 아니면 기저가 됩니다.",
            "mood": "neutral"
          }
        ],
        "s1-2:0": [
          {
            "say": "\\(y_1=e^x,\\ y_2=e^{-x},\\ y_3=e^{x/2}\\)의 W는 \\(\\frac32 e^{x/2}\\neq0\\).",
            "mood": "neutral"
          },
          {
            "say": "일반 함수들에는 W가 한 점에서 0이라는 사실만으로 종속을 결론 내리지 않습니다.",
            "mood": "neutral"
          }
        ]
      },
      "check": "q1"
    },
    {
      "title": "서로 다른 실근",
      "script": {
        "s2-1:0": [
          {
            "say": "상수계수 식에 y=e^{λx}를 넣어 특성방정식을 만듭니다.",
            "mood": "neutral"
          },
          {
            "say": "서로 다른 실근 λ마다 e^{λx} 하나를 일반해에 넣습니다.",
            "mood": "neutral"
          }
        ],
        "s2-2:0": [
          {
            "say": "y‴−2y″−y′+2y=0: λ³−2λ²−λ+2=(λ−1)(λ+1)(λ−2).",
            "mood": "neutral"
          },
          {
            "say": "일반해는 c₁eˣ+c₂e⁻ˣ+c₃e²ˣ입니다.",
            "mood": "neutral"
          }
        ]
      },
      "check": "q2"
    },
    {
      "title": "중근과 복소 이중근",
      "script": {
        "s3-1:0": [
          {
            "say": "실근 λ가 m중근이면 e^{λx},xe^{λx},…,x^{m−1}e^{λx}.",
            "mood": "neutral"
          },
          {
            "say": "복소근 α±iβ가 이중근이면 e^{αx}cosβx, e^{αx}sinβx와 각각 x를 곱한 해가 필요합니다.",
            "mood": "neutral"
          }
        ],
        "s3-2:0": [
          {
            "say": "y⁽⁴⁾+2y″+y=0: (λ²+1)².",
            "mood": "neutral"
          },
          {
            "say": "일반해는 (c₁+c₂x)cos x+(c₃+c₄x)sin x입니다.",
            "mood": "neutral"
          },
          {
            "say": "독립인 해가 총 네 개입니다.",
            "mood": "neutral"
          }
        ]
      },
      "check": "q3"
    },
    {
      "title": "0 중근과 다른 중근 함께",
      "script": {
        "s4-1:0": [
          {
            "say": "근 0에 대응하는 e⁰ˣ는 1입니다.",
            "mood": "neutral"
          },
          {
            "say": "0이 이중근이면 1과 x를 넣습니다.",
            "mood": "neutral"
          },
          {
            "say": "다른 근의 중복도 따로 처리합니다.",
            "mood": "neutral"
          }
        ],
        "s4-2:0": [
          {
            "say": "y⁽⁵⁾−3y⁽⁴⁾+3y‴−y″=0: λ²(λ−1)³.",
            "mood": "neutral"
          },
          {
            "say": "일반해는 c₁+c₂x+(c₃+c₄x+c₅x²)eˣ입니다.",
            "mood": "neutral"
          },
          {
            "say": "상수는 5개입니다.",
            "mood": "neutral"
          }
        ]
      },
      "check": "q4"
    },
    {
      "title": "고계 오일러코시",
      "script": {
        "s5-1:0": [
          {
            "say": "오일러코시는 y=xᵐ을 직접 대입합니다.",
            "mood": "neutral"
          },
          {
            "say": "y′=mx^{m−1}, y″=m(m−1)x^{m−2}, y‴=m(m−1)(m−2)x^{m−3}.",
            "mood": "neutral"
          },
          {
            "say": "여기서는 x>0 구간을 씁니다.",
            "mood": "neutral"
          }
        ],
        "s5-2:0": [
          {
            "say": "x³y‴−3x²y″+6xy′−6y=0: m(m−1)(m−2)−3m(m−1)+6m−6=(m−1)(m−2)(m−3).",
            "mood": "neutral"
          },
          {
            "say": "따라서 c₁x+c₂x²+c₃x³.",
            "mood": "neutral"
          }
        ]
      },
      "check": "q5"
    },
    {
      "title": "비제차 공명과 초기조건",
      "script": {
        "s6-1:0": [
          {
            "say": "우변 e^{αx}가 특성근 α와 겹치면 그 근의 중복도 m만큼 xᵐ을 곱해 특수해를 가정합니다.",
            "mood": "neutral"
          },
          {
            "say": "제차해부터 구해야 겹침을 판단할 수 있습니다.",
            "mood": "neutral"
          }
        ],
        "s6-2:0": [
          {
            "say": "y‴+3y″+3y′+y=30e⁻ˣ: 근 −1이 3중근.",
            "mood": "neutral"
          },
          {
            "say": "yₚ=Ax³e⁻ˣ를 넣으면 6Ae⁻ˣ, A=5.",
            "mood": "neutral"
          },
          {
            "say": "y(0)=3,y′(0)=−3,y″(0)=−47이면 y=(3−25x²+5x³)e⁻ˣ입니다.",
            "mood": "neutral"
          }
        ]
      },
      "check": "q6"
    }
  ],
