  "date": "2026-10-02",
  "title": "27장 회로 — 키르히호프 부호·RC 충전·시상수",
  "goals": [
    "접점과 고리 규칙",
    "전위 변화 부호",
    "연립식과 음수 전류",
    "RC 충전 식 세우기",
    "시상수와 63%",
    "충전 전류와 극한"
  ],
  "recap": [],
  "sections": [
    {
      "title": "접점과 고리 규칙",
      "script": {
        "s1-1:0": [
          {
            "say": "접점에서는 들어오는 전류의 합=나가는 전류의 합입니다.",
            "mood": "neutral"
          },
          {
            "say": "고리에서는 한 바퀴의 전위 변화 합이 0입니다.",
            "mood": "neutral"
          },
          {
            "say": "전류의 가정 방향과 고리를 도는 방향을 먼저 표시합니다.",
            "mood": "neutral"
          }
        ],
        "s1-2:0": [
          {
            "say": "접점에 0.50 A가 들어오고 0.20 A와 I가 나가면 0.50=0.20+I, 따라서 I=0.30 A입니다.",
            "mood": "neutral"
          },
          {
            "say": "전하가 접점에 쌓이지 않는 정상 상태의 규칙입니다.",
            "mood": "neutral"
          }
        ]
      },
      "check": "q1"
    },
    {
      "title": "전위 변화 부호",
      "script": {
        "s2-1:0": [
          {
            "say": "저항을 전류 방향으로 지나면 전위 변화는 −IR, 반대면 +IR입니다.",
            "mood": "neutral"
          },
          {
            "say": "전지를 −극에서 +극으로 지나면 +ε, 반대면 −ε입니다.",
            "mood": "neutral"
          },
          {
            "say": "이 변화들을 더해 0으로 둡니다.",
            "mood": "neutral"
          }
        ],
        "s2-2:0": [
          {
            "say": "6 V 전지의 −→+를 지나고 I=0.5 A인 4 Ω 저항을 전류 방향으로 지나면 +6−(0.5×4)=+4 V입니다.",
            "mood": "neutral"
          },
          {
            "say": "전체 고리를 쓰려면 나머지 소자도 포함해야 합니다.",
            "mood": "neutral"
          }
        ]
      },
      "check": "q2"
    },
    {
      "title": "연립식과 음수 전류",
      "script": {
        "s3-1:0": [
          {
            "say": "처음 정한 전류 화살표를 기준으로 부호를 유지해 연립식을 풉니다.",
            "mood": "neutral"
          },
          {
            "say": "전류 해가 음수면 실제 방향이 가정한 화살표와 반대입니다.",
            "mood": "neutral"
          }
        ],
        "s3-2:0": [
          {
            "say": "판서 식: i₁+i₂−i₃=0, −4i₁−4i₃=−3, −4i₂−4i₃=0.",
            "mood": "neutral"
          },
          {
            "say": "마지막 식에서 i₂=−i₃, 첫 식에서 i₁=2i₃.",
            "mood": "neutral"
          },
          {
            "say": "따라서 (i₁,i₂,i₃)=(1/2,−1/4,1/4) A입니다.",
            "mood": "neutral"
          }
        ]
      },
      "check": "q3"
    },
    {
      "title": "RC 충전 식 세우기",
      "script": {
        "s4-1:0": [
          {
            "say": "전압 ε의 전지·저항 R·축전기 C가 직렬인 충전 회로에서 \\(\\varepsilon=iR+q/C\\), \\(i=dq/dt\\).",
            "mood": "neutral"
          },
          {
            "say": "따라서 \\(R\\,dq/dt+q/C=\\varepsilon\\).",
            "mood": "neutral"
          }
        ],
        "s4-2:0": [
          {
            "say": "충전 전 q(0)=0이면 \\(q(t)=C\\varepsilon(1-e^{-t/(RC)})\\).",
            "mood": "neutral"
          },
          {
            "say": "t=0이면 0, t→∞이면 Cε이므로 초기값과 최종값을 확인할 수 있습니다.",
            "mood": "neutral"
          }
        ]
      },
      "check": "q4"
    },
    {
      "title": "시상수와 63%",
      "script": {
        "s5-1:0": [
          {
            "say": "시상수 \\(\\tau=RC\\)의 단위는 초입니다.",
            "mood": "neutral"
          },
          {
            "say": "처음 전하가 0인 충전에서 t=τ이면 \\(q/(C\\varepsilon)=1-e^{-1}\\approx0.632\\).",
            "mood": "neutral"
          },
          {
            "say": "최종 전하의 약 63.2%입니다.",
            "mood": "neutral"
          }
        ],
        "s5-2:0": [
          {
            "say": "R=2 kΩ, C=100 μF이면 τ=(2000 Ω)(100×10⁻⁶ F)=0.20 s.",
            "mood": "neutral"
          },
          {
            "say": "k와 μ를 기본 단위로 바꾼 뒤 곱합니다.",
            "mood": "neutral"
          }
        ]
      },
      "check": "q5"
    },
    {
      "title": "충전 전류와 극한",
      "script": {
        "s6-1:0": [
          {
            "say": "충전 전류는 \\(i=dq/dt=(\\varepsilon/R)e^{-t/(RC)}\\).",
            "mood": "neutral"
          },
          {
            "say": "처음에는 ε/R이고 시간이 지나면 0으로 감소합니다.",
            "mood": "neutral"
          },
          {
            "say": "전하는 증가하고 전류는 감소합니다.",
            "mood": "neutral"
          }
        ],
        "s6-2:0": [
          {
            "say": "ε=12 V, R=4 kΩ이면 i(0)=12/4000=3 mA.",
            "mood": "neutral"
          },
          {
            "say": "t=τ에는 3/e≈1.10 mA입니다.",
            "mood": "neutral"
          },
          {
            "say": "전류가 초기값의 36.8% 남는 때 전하는 최종값의 63.2%입니다.",
            "mood": "neutral"
          }
        ]
      },
      "check": "q6"
    }
  ],
