  "title": "12.5 평면과 교선 — 법선·외적·사잇각",
  "goals": [
    "평면의 법선벡터",
    "세 점을 지나는 평면",
    "교선의 방향벡터",
    "교선 위의 점과 방정식",
    "두 평면 사이의 작은 각"
  ],
  "recap": [],
  "sections": [
    {
      "title": "평면의 법선벡터",
      "script": {
        "s1-1:0": [
          {
            "say": "평면 \\(Ax+By+Cz=D\\)의 법선벡터는 \\((A,B,C)\\)입니다.",
            "mood": "neutral"
          },
          {
            "say": "평면 안의 방향벡터와 내적하면 0입니다.",
            "mood": "neutral"
          }
        ],
        "s1-2:0": [
          {
            "say": "예제: \\(x+y+z=1\\)의 법선은 \\((1,1,1)\\).",
            "mood": "neutral"
          },
          {
            "say": "점 \\((1,0,0)\\)을 넣으면 좌변이 1이므로 이 평면 위에 있습니다.",
            "mood": "neutral"
          }
        ]
      },
      "check": "q1"
    },
    {
      "title": "세 점을 지나는 평면",
      "script": {
        "s2-1:0": [
          {
            "say": "세 점 P,Q,R에서 \\(\\overrightarrow{PQ}\\), \\(\\overrightarrow{PR}\\)를 만듭니다.",
            "mood": "neutral"
          },
          {
            "say": "외적이 0이 아니면 두 벡터에 수직인 법선이 됩니다.",
            "mood": "neutral"
          }
        ],
        "s2-2:0": [
          {
            "say": "P(1,3,2), Q(3,−1,6), R(5,2,0): PQ=(2,−4,4), PR=(4,−1,−2).",
            "mood": "neutral"
          },
          {
            "say": "외적=(12,20,14).",
            "mood": "neutral"
          },
          {
            "say": "따라서 \\(6x+10y+7z=50\\).",
            "mood": "neutral"
          },
          {
            "say": "세 점을 각각 넣어 확인합니다.",
            "mood": "neutral"
          }
        ]
      },
      "check": "q2"
    },
    {
      "title": "교선의 방향벡터",
      "script": {
        "s3-1:0": [
          {
            "say": "두 평면의 교선은 두 법선에 모두 수직입니다.",
            "mood": "neutral"
          },
          {
            "say": "법선의 외적이 0이 아니면 그 외적을 교선의 방향벡터로 쓸 수 있습니다.",
            "mood": "neutral"
          }
        ],
        "s3-2:0": [
          {
            "say": "\\(x+y+z=1\\), \\(x-2y+3z=1\\): 법선은 (1,1,1), (1,−2,3).",
            "mood": "neutral"
          },
          {
            "say": "외적=(5,−2,−3).",
            "mood": "neutral"
          },
          {
            "say": "두 법선과 내적하면 각각 0입니다.",
            "mood": "neutral"
          }
        ]
      },
      "check": "q3"
    },
    {
      "title": "교선 위의 점과 방정식",
      "script": {
        "s4-1:0": [
          {
            "say": "방향벡터만으로 직선의 위치는 정해지지 않습니다.",
            "mood": "neutral"
          },
          {
            "say": "두 평면을 동시에 만족하는 점도 하나 찾아야 합니다.",
            "mood": "neutral"
          }
        ],
        "s4-2:0": [
          {
            "say": "앞의 두 평면에서 z=0으로 두면 x+y=1, x−2y=1.",
            "mood": "neutral"
          },
          {
            "say": "따라서 (1,0,0).",
            "mood": "neutral"
          },
          {
            "say": "교선은 \\(\\mathbf r(t)=(1,0,0)+t(5,-2,-3)\\).",
            "mood": "neutral"
          },
          {
            "say": "두 평면에 대입하면 모든 t에서 1입니다.",
            "mood": "neutral"
          }
        ]
      },
      "check": "q4"
    },
    {
      "title": "두 평면 사이의 작은 각",
      "script": {
        "s5-1:0": [
          {
            "say": "평면 사이의 작은 각 \\(0\\leq\\theta\\leq\\pi/2\\)는 \\(\\cos\\theta=|\\mathbf n_1\\cdot\\mathbf n_2|/(|\\mathbf n_1||\\mathbf n_2|)\\)로 구합니다.",
            "mood": "neutral"
          },
          {
            "say": "절댓값으로 법선의 부호 선택 영향을 없앱니다.",
            "mood": "neutral"
          }
        ],
        "s5-2:0": [
          {
            "say": "(1,1,1)·(1,−2,3)=2, 크기는 √3과 √14.",
            "mood": "neutral"
          },
          {
            "say": "따라서 \\(\\cos\\theta=2/\\sqrt{42}\\).",
            "mood": "neutral"
          },
          {
            "say": "각도는 이 값의 역코사인입니다.",
            "mood": "neutral"
          }
        ]
      },
      "check": "q5"
    }
  ],
